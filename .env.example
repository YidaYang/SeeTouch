# ============================================
# OpenAI 兼容 API（默认）
# ============================================
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_ID=gpt-4.1-mini
# 思考强度: 留空=模型默认; minimal|low|medium|high|xhigh
OPENAI_REASONING_EFFORT=

# ============================================
# Gemini API（使用 --reasoner gemini）
# ============================================
GEMINI_API_KEY=
GEMINI_MODEL_ID=gemini-3.1-flash-lite

# ============================================
# Doubao Vision API（使用 --reasoner doubao）
# ============================================
VLM_API_KEY=
DOUBAO_MODEL_ID=doubao-seed-1-6-vision-250815
DOUBAO_API_URL=https://ark.cn-beijing.volces.com/api/v3
# Doubao thinking 模式
# enabled:  开启 VisualCoT(默认,准确率最高,慢且贵)
# disabled: 不思考(最快最便宜,简单任务足够)
# auto:     模型按需思考(注意:vision 模型不支持 auto)
SEETOUCH_THINKING_MODE=enabled

# ============================================
# 可选配置
# ============================================
SEETOUCH_DEVICE_SERIAL=
SEETOUCH_RUNS_DIR=./runs
SEETOUCH_MAX_STEPS=45
