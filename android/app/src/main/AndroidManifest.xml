<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- VLM API 调用需要联网 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Android 11+ 包可见性:声明需要查询所有桌面可启动应用 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".SeeTouchApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SeeTouch">

        <!-- 设备层核心:手势注入/截图/前台 app 跟踪/BACK/HOME -->
        <service
            android:name=".device.SeeTouchAccessibilityService"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- 无 UI 任务执行入口(Phase 1 诊断用),ADB 触发,日志打 tag SEETOUCH_RUN -->
        <activity
            android:name=".diag.TaskRunActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Python 运行时自检(诊断用),ADB 触发,报告打到 logcat tag SEETOUCH_PY -->
        <activity
            android:name=".diag.PythonSelfTestActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- PC 端 ADB 触发的应用索引导出入口，无桌面图标、透明不打断前台 -->
        <activity
            android:name=".helper.AppListExportActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
    </application>

</manifest>